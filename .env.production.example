# Config de producción para docker-compose.prod.yml.
# Copiar como ".env.production" (sin el ".example") y completar con
# valores reales. Ese archivo NO se commitea (ver .gitignore).

# --- Base de datos (usada por el servicio "db" y para armar el DATABASE_URL) ---
DB_USER=peluquero
DB_PASSWORD=cambiar-por-una-contraseña-fuerte-y-unica
DB_NAME=peluqueria

# --- Aplicación ---
NODE_ENV=production
PORT=3000
# Dominio real del sitio, sin barra final. Puede llevar varios separados por coma.
CORS_ORIGIN=https://tudominio.com
FRONTEND_URL=https://tudominio.com

# --- JWT ---
# Generar uno nuevo y fuerte, distinto al de desarrollo, ej: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Password reset emails (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Authentic Barber <noreply@tudominio.com>"

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tudominio.com/api/google-calendar/callback
GOOGLE_CALENDAR_ID=

# --- Cloudinary (subida de imágenes de productos/servicios/cursos) ---
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
