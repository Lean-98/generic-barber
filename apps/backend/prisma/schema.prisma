generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Servicio {
  idServicio     Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  idCategoria    Int?     @map("id_categoria")
  precio         Decimal  @db.Decimal(10, 2)
  duracionMinutos Int
  urlImagen      String?
  vigente        Boolean  @default(true)
  cuentaParaFidelizacion Boolean @default(false) @map("cuenta_para_fidelizacion")
  /// Costo estimado de insumos por cada vez que se hace el servicio (para el
  /// reporte de rentabilidad). 0 = no cargado.
  costoInsumos   Decimal  @default(0) @db.Decimal(10, 2) @map("costo_insumos")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  categoria CategoriaServicio? @relation(fields: [idCategoria], references: [idCategoria], onDelete: SetNull)
  detalles  TurnoDetalle[]
  historial ServicioHistorial[]

  @@map("servicios")
}

model ServicioHistorial {
  idHistorial     Int      @id @default(autoincrement())
  idServicio      Int
  precio          Decimal  @db.Decimal(10, 2)
  duracionMinutos Int
  vigente         Boolean
  fechaCambio     DateTime @default(now()) @map("fecha_cambio")

  servicio Servicio @relation(fields: [idServicio], references: [idServicio], onDelete: Cascade)

  @@map("servicios_historial")
}

model Turno {
  idTurno         Int      @id @default(autoincrement())
  idPersona       Int
  fechaHoraInicio DateTime @map("fecha_hora_inicio")
  fechaHoraFin    DateTime @map("fecha_hora_fin")
  estado          String   @default("CONFIRMADO")
  observacion     String?
  fechaCreacion   DateTime @default(now()) @map("fecha_creacion")
  googleEventId   String?  @map("google_event_id")
  recordatorioEnviadoEn DateTime? @map("recordatorio_enviado_en")
  /// Preferencia elegida por el cliente al reservar online; no es el pago real
  /// (eso sigue siendo explícito en caja), solo sirve para precargar la forma
  /// de pago sugerida al cobrar. Nullable porque el alta manual de un turno
  /// desde el panel no la pide.
  idFormaPagoPreferida Int? @map("id_forma_pago_preferida")
  /// Quién y cuándo canceló el turno ("CLIENTE" desde el link del mail, o
  /// "PANEL" desde la administración). Con canceladoEn vs. fechaHoraInicio se
  /// puede calcular más adelante cuánta anticipación tuvo cada cancelación.
  canceladoEn  DateTime? @map("cancelado_en")
  canceladoPor String?   @map("cancelado_por")
  /// Cupón con el que se reservó online (el descuento queda en los detalles,
  /// con descuentoMotivo = "CUPON"). Sirve para contar usos: un turno
  /// cancelado devuelve el cupón.
  idCupon      Int?      @map("id_cupon")

  persona             Persona        @relation(fields: [idPersona], references: [idPersona])
  detalles             TurnoDetalle[]
  pagos                Pago[]
  movimientos          MovimientoCaja[]
  formaPagoPreferida   FormaPago?     @relation(fields: [idFormaPagoPreferida], references: [idFormaPago])
  cupon                Cupon?         @relation(fields: [idCupon], references: [idCupon])

  @@index([idCupon])
  @@map("turnos")
}

model TurnoDetalle {
  idTurnoDetalle Int     @id @default(autoincrement())
  idTurno        Int
  idServicio     Int
  precioReal     Decimal @db.Decimal(10, 2) @map("precio_real")
  cantidad       Int     @default(1)
  descuentoPorcentaje Decimal @default(0) @db.Decimal(5, 2) @map("descuento_porcentaje")
  descuentoMotivo     String? @map("descuento_motivo")

  turno    Turno    @relation(fields: [idTurno], references: [idTurno], onDelete: Cascade)
  servicio Servicio @relation(fields: [idServicio], references: [idServicio])

  @@map("turno_detalles")
}

model Persona {
  idPersona      Int       @id @default(autoincrement())
  nombre         String
  apellido       String
  mail           String?   @unique
  telefono       String?
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  instagram      String?
  ultimoCorte    DateTime? @map("ultimo_corte")
  usuario        String?   @unique
  aplicaDescuentoPersonal Boolean @default(false) @map("aplica_descuento_personal")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  turnos      Turno[]
  usuarioWeb  UsuarioWeb?

  @@map("personas")
}

model UsuarioWeb {
  usuario  String  @id
  email    String  @unique
  hashPass String  @map("hash_pass")
  idPersona Int   @unique @map("id_persona")
  rol      String  @default("PELUQUERO")

  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  twoFactorCodeHash      String?   @map("two_factor_code_hash")
  twoFactorCodeExpiresAt DateTime? @map("two_factor_code_expires_at")

  persona      Persona        @relation(fields: [idPersona], references: [idPersona])
  movimientos  MovimientoCaja[]
  cierres      CierreCaja[]
  dispositivosConfiables DispositivoConfiable[]

  @@map("usuarios_web")
}

// Dispositivo en el que un usuario eligió "recordar este dispositivo" al
// verificar el 2FA, para no tener que pedirle el código de nuevo en cada
// login mientras el token siga vigente (ver auth.service.ts).
model DispositivoConfiable {
  id         Int      @id @default(autoincrement())
  usuario    String
  tokenHash  String   @unique @map("token_hash")
  expiraEn   DateTime @map("expira_en")
  creadoEn   DateTime @default(now()) @map("creado_en")

  usuarioWeb UsuarioWeb @relation(fields: [usuario], references: [usuario], onDelete: Cascade)

  @@map("dispositivos_confiables")
}

model FormaPago {
  idFormaPago         Int     @id @default(autoincrement())
  nombre              String
  requiereComprobante Boolean @default(false) @map("requiere_comprobante")
  vigente             Boolean @default(true)

  pagos             Pago[]
  movimientos       MovimientoCaja[]
  turnosPreferencia Turno[]

  @@map("formas_pago")
}

model Pago {
  idPago      Int      @id @default(autoincrement())
  idTurno     Int
  idFormaPago Int
  monto       Decimal  @db.Decimal(10, 2)
  comprobante String?
  fechaHora   DateTime @default(now()) @map("fecha_hora")

  turno     Turno     @relation(fields: [idTurno], references: [idTurno])
  formaPago FormaPago @relation(fields: [idFormaPago], references: [idFormaPago])

  @@map("pagos")
}

model MovimientoCaja {
  idMovimiento Int      @id @default(autoincrement())
  fechaHora    DateTime @default(now()) @map("fecha_hora")
  tipo         String
  monto        Decimal  @db.Decimal(10, 2)
  concepto     String?
  idFormaPago  Int      @map("id_forma_pago")
  idUsuario    String   @map("id_usuario")
  idTurno      Int?     @map("id_turno")
  /// Venta de un producto desde la caja: qué se vendió y cuántas unidades
  /// (se descuentan del stock del producto).
  idProducto       Int? @map("id_producto")
  cantidadProducto Int? @map("cantidad_producto")

  formaPago FormaPago  @relation(fields: [idFormaPago], references: [idFormaPago])
  usuario   UsuarioWeb @relation(fields: [idUsuario], references: [usuario])
  turno     Turno?     @relation(fields: [idTurno], references: [idTurno])
  producto  Producto?  @relation(fields: [idProducto], references: [idProducto])

  @@map("movimientos_caja")
}

model CierreCaja {
  idCierre          Int      @id @default(autoincrement())
  fecha             DateTime @db.Date
  horaInicio        DateTime @map("hora_inicio")
  horaFin           DateTime? @map("hora_fin")
  totalEfectivo     Decimal  @db.Decimal(10, 2) @map("total_efectivo")
  totalTarjeta      Decimal  @db.Decimal(10, 2) @map("total_tarjeta")
  totalTransferencia Decimal @db.Decimal(10, 2) @map("total_transferencia")
  totalOtros        Decimal  @db.Decimal(10, 2) @map("total_otros")
  totalEsperado     Decimal  @db.Decimal(10, 2) @map("total_esperado")
  totalReal         Decimal  @db.Decimal(10, 2) @map("total_real")
  diferencia        Decimal  @db.Decimal(10, 2)
  idUsuarioCierra   String   @map("id_usuario_cierra")

  usuarioCierra UsuarioWeb @relation(fields: [idUsuarioCierra], references: [usuario])

  @@map("cierres_caja")
}

model GoogleCalendarConfig {
  id          Int      @id @default(autoincrement())
  accessToken String   @map("access_token")
  refreshToken String  @map("refresh_token")
  expiryDate  DateTime? @map("expiry_date")
  calendarId  String   @map("calendar_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("google_calendar_config")
}

model ConfiguracionNegocio {
  id               Int      @id @default(autoincrement())
  nombre           String   @default("Peluquería")
  logoUrl          String?  @map("logo_url")
  iconoUrl         String?  @map("icono_url")
  colorPrimario    String?  @map("color_primario")
  colorSecundario  String?  @map("color_secundario")
  heroImageUrl     String?  @map("hero_image_url")
  descripcion      String?
  telefono         String?
  email            String?
  direccion        String?
  instagramUrl     String?  @map("instagram_url")
  facebookUrl      String?  @map("facebook_url")
  googleReviewsUrl String?  @map("google_reviews_url")
  whatsappUrl      String?  @map("whatsapp_url")
  politicaReservas String?  @map("politica_reservas")
  horarios         Json?
  galeriaUrls      Json?    @map("galeria_urls")
  productosTitulo      String?  @map("productos_titulo")
  productosDescripcion String?  @map("productos_descripcion")
  cursosTitulo         String?  @map("cursos_titulo")
  cursosDescripcion    String?  @map("cursos_descripcion")
  sobreNosotros    Json?    @map("sobre_nosotros")
  sobreNosotrosBajada String? @map("sobre_nosotros_bajada")
  clubNombre String? @map("club_nombre")
  clubBajada String? @map("club_bajada")
  clubImagenUrl String? @map("club_imagen_url")
  clubBeneficios Json? @map("club_beneficios")
  clubNota String? @map("club_nota")
  mostrarNosotros       Boolean @default(true) @map("mostrar_nosotros")
  mostrarClub  Boolean @default(true) @map("mostrar_club")
  mostrarTienda         Boolean @default(true) @map("mostrar_tienda")
  mostrarCursos         Boolean @default(true) @map("mostrar_cursos")
  mostrarServicios      Boolean @default(true) @map("mostrar_servicios")
  mostrarGaleria        Boolean @default(true) @map("mostrar_galeria")
  mostrarUbicacion      Boolean @default(true) @map("mostrar_ubicacion")
  fidelizacionActiva              Boolean  @default(false) @map("fidelizacion_activa")
  fidelizacionVisitasRequeridas   Int?     @map("fidelizacion_visitas_requeridas")
  fidelizacionDescuentoPorcentaje Decimal? @db.Decimal(5, 2) @map("fidelizacion_descuento_porcentaje")
  fidelizacionFechaInicio         DateTime? @db.Date @map("fidelizacion_fecha_inicio")
  descuentoEmpleadoActivo         Boolean  @default(false) @map("descuento_empleado_activo")
  descuentoEmpleadoPorcentaje     Decimal? @db.Decimal(5, 2) @map("descuento_empleado_porcentaje")
  /// Si está apagado, no se manda el recordatorio de turno por email.
  recordatorioActivo              Boolean  @default(true) @map("recordatorio_activo")
  recordatorioHorasAntes          Int      @default(24) @map("recordatorio_horas_antes")
  /// Anticipación mínima para reservar online, en minutos: la página de
  /// reservas no ofrece ni acepta horarios que empiezan antes de ahora + esto.
  /// No aplica a los turnos cargados desde el panel.
  reservaAnticipacionMinutos      Int      @default(15) @map("reserva_anticipacion_minutos")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("configuracion_negocio")
}

model Categoria {
  idCategoria Int      @id @default(autoincrement())
  nombre      String
  vigente     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  productos Producto[]

  @@map("categorias")
}

model CategoriaServicio {
  idCategoria Int      @id @default(autoincrement())
  nombre      String
  vigente     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  servicios Servicio[]

  @@map("categorias_servicios")
}

model Producto {
  idProducto  Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Decimal  @db.Decimal(10, 2)
  urlImagen   String?
  idCategoria Int?     @map("id_categoria")
  vigente     Boolean  @default(true)
  /// null = no se controla stock de este producto. Con stockMinimo cargado,
  /// el dashboard avisa cuando stock <= stockMinimo.
  stock       Int?
  stockMinimo Int?     @map("stock_minimo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoria   Categoria? @relation(fields: [idCategoria], references: [idCategoria], onDelete: SetNull)
  movimientos MovimientoCaja[]

  @@map("productos")
}

model Curso {
  idCurso              Int      @id @default(autoincrement())
  nombre               String
  subtitulo            String?
  descripcion          String?
  precio               Decimal  @db.Decimal(10, 2)
  duracion             String?
  temario              String[] @default([])
  fechaInicio          DateTime? @map("fecha_inicio")
  fechaFin             DateTime? @map("fecha_fin")
  diaCursada           String[] @default([]) @map("dia_cursada")
  horario              String?
  lugar                String?
  cupos                Int?
  inscripcionInicio    DateTime? @map("inscripcion_inicio")
  inscripcionHasta     DateTime? @map("inscripcion_hasta")
  requisitoImportante  String?  @map("requisito_importante")
  urlImagen            String?
  vigente              Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("cursos")
}

// Costos del negocio para el reporte de rentabilidad. Tabla aparte (y no en
// configuracion_negocio) porque esa configuración se expone públicamente para
// la landing, y estos números son internos. Una sola fila (id = 1).
model CostosNegocio {
  id                   Int      @id @default(1)
  costosFijosMensuales Decimal  @default(0) @db.Decimal(12, 2) @map("costos_fijos_mensuales")
  costoHoraTrabajo     Decimal  @default(0) @db.Decimal(10, 2) @map("costo_hora_trabajo")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("costos_negocio")
}

/// Cupón de descuento para la reserva online (ej. "HOY20" para compartir por
/// WhatsApp). Vale para las reservas hechas entre vigenteDesde y vigenteHasta
/// (el día del turno no importa), una vez por cliente (email), para todos los
/// servicios. No se acumula con otros descuentos: se aplica el mayor.
model Cupon {
  idCupon             Int      @id @default(autoincrement())
  /// En mayúsculas, sin espacios.
  codigo              String   @unique
  descripcion         String?
  descuentoPorcentaje Decimal  @db.Decimal(5, 2) @map("descuento_porcentaje")
  vigenteDesde        DateTime @map("vigente_desde")
  vigenteHasta        DateTime @map("vigente_hasta")
  /// Cupo total ("los primeros 10"); null = sin límite.
  usosMaximos         Int?     @map("usos_maximos")
  /// Pausado desde el panel.
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")

  turnos Turno[]

  @@map("cupones")
}
